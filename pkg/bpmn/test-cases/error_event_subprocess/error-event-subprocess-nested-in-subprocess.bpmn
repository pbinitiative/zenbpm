  <bpmn:process id="error-event-subprocess-nested-in-subprocess" name="Error Event Subprocess Nested In Subprocess" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_start_sub</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_start_sub" sourceRef="StartEvent_1" targetRef="outer-embedded-sub" />
    <bpmn:subProcess id="outer-embedded-sub" name="Outer embedded subprocess">
      <bpmn:incoming>Flow_start_sub</bpmn:incoming>
      <bpmn:outgoing>Flow_sub_end</bpmn:outgoing>
      <bpmn:startEvent id="outer-sub-start">
        <bpmn:outgoing>Flow_sub_task</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_sub_task" sourceRef="outer-sub-start" targetRef="outer-sub-task" />
      <bpmn:serviceTask id="outer-sub-task" name="Outer sub task">
        <bpmn:extensionElements>
          <zenbpm:taskDefinition type="nested-error-outer-sub-task" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_sub_task</bpmn:incoming>
        <bpmn:outgoing>Flow_sub_success</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_sub_success" sourceRef="outer-sub-task" targetRef="outer-sub-should-not-happen-end" />
      <bpmn:endEvent id="outer-sub-should-not-happen-end" name="Should not happen end">
        <bpmn:incoming>Flow_sub_success</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:subProcess id="nested-error-event-subprocess" triggeredByEvent="true">
        <bpmn:startEvent id="nested-error-start-event">
          <bpmn:outgoing>Flow_error_handled</bpmn:outgoing>
          <bpmn:errorEventDefinition id="ErrorEventDefinition_nested" errorRef="Error_nested_fail" />
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="Flow_error_handled" sourceRef="nested-error-start-event" targetRef="nested-handled-end" />
        <bpmn:endEvent id="nested-handled-end" name="Handled end">
          <bpmn:incoming>Flow_error_handled</bpmn:incoming>
        </bpmn:endEvent>
      </bpmn:subProcess>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_sub_end" sourceRef="outer-embedded-sub" targetRef="process-end" />
    <bpmn:endEvent id="process-end" name="End">
      <bpmn:incoming>Flow_sub_end</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:error id="Error_nested_fail" name="Nested fail test error" errorCode="42" />
