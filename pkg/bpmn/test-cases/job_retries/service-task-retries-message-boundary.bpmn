<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0" id="Definitions_service-task-retries-message-boundary" targetNamespace="http://bpmn.io/schema/bpmn" exporter="ZenBPM Modeler" exporterVersion="1.0.0">
  <bpmn:process id="service-task-retries-message-boundary" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_start" sourceRef="StartEvent_1" targetRef="retried-task" />
    <bpmn:serviceTask id="retried-task" name="Retried">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="charge-card" retries="3" retryBackoff="PT1H" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start</bpmn:incoming>
      <bpmn:outgoing>Flow_done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_done" sourceRef="retried-task" targetRef="done-end" />
    <bpmn:endEvent id="done-end" name="Done">
      <bpmn:incoming>Flow_done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="cancel-boundary" name="Order cancelled" attachedToRef="retried-task">
      <bpmn:outgoing>Flow_cancelled</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_cancel" messageRef="order-cancelled-message" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_cancelled" sourceRef="cancel-boundary" targetRef="cancelled-end" />
    <bpmn:endEvent id="cancelled-end" name="Cancelled">
      <bpmn:incoming>Flow_cancelled</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:message id="order-cancelled-message" name="order-cancelled">
    <bpmn:extensionElements>
      <zenbpm:subscription correlationKey="=orderId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="service-task-retries-message-boundary">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="182" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="retried-task_di" bpmnElement="retried-task">
        <dc:Bounds x="270" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_di" bpmnElement="Flow_start">
        <di:waypoint x="218" y="100" />
        <di:waypoint x="270" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="done-end_di" bpmnElement="done-end">
        <dc:Bounds x="442" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_done_di" bpmnElement="Flow_done">
        <di:waypoint x="370" y="100" />
        <di:waypoint x="442" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="cancel-boundary_di" bpmnElement="cancel-boundary">
        <dc:Bounds x="302" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cancelled-end_di" bpmnElement="cancelled-end">
        <dc:Bounds x="442" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_cancelled_di" bpmnElement="Flow_cancelled">
        <di:waypoint x="320" y="158" />
        <di:waypoint x="320" y="220" />
        <di:waypoint x="442" y="220" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
