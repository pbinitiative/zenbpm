<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_manual_task_in_sub_process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="ZenBPM Modeler" exporterVersion="1.0.0">
  <bpmn:process id="manual-task-in-sub-process-process" name="Manual task in sub process" isExecutable="true">
    <bpmn:startEvent id="start">
      <bpmn:outgoing>flow-start-to-sub-process</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow-start-to-sub-process" sourceRef="start" targetRef="sub-process" />
    <bpmn:subProcess id="sub-process" name="Handle the contract">
      <bpmn:incoming>flow-start-to-sub-process</bpmn:incoming>
      <bpmn:outgoing>flow-sub-process-to-end</bpmn:outgoing>
      <bpmn:startEvent id="sub-process-start">
        <bpmn:outgoing>flow-sub-process-start-to-manual-task</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="flow-sub-process-start-to-manual-task" sourceRef="sub-process-start" targetRef="manual-task" />
      <bpmn:manualTask id="manual-task" name="Sign the contract">
        <bpmn:incoming>flow-sub-process-start-to-manual-task</bpmn:incoming>
        <bpmn:outgoing>flow-manual-task-to-sub-process-end</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:sequenceFlow id="flow-manual-task-to-sub-process-end" sourceRef="manual-task" targetRef="sub-process-end" />
      <bpmn:endEvent id="sub-process-end">
        <bpmn:incoming>flow-manual-task-to-sub-process-end</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="flow-sub-process-to-end" sourceRef="sub-process" targetRef="end" />
    <bpmn:endEvent id="end">
      <bpmn:incoming>flow-sub-process-to-end</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="manual-task-in-sub-process-process">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="152" y="152" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sub-process_di" bpmnElement="sub-process" isExpanded="true">
        <dc:Bounds x="240" y="70" width="400" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sub-process-start_di" bpmnElement="sub-process-start">
        <dc:Bounds x="280" y="152" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="manual-task_di" bpmnElement="manual-task">
        <dc:Bounds x="380" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sub-process-end_di" bpmnElement="sub-process-end">
        <dc:Bounds x="552" y="152" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="702" y="152" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-start-to-sub-process_di" bpmnElement="flow-start-to-sub-process">
        <di:waypoint x="188" y="170" />
        <di:waypoint x="240" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-sub-process-start-to-manual-task_di" bpmnElement="flow-sub-process-start-to-manual-task">
        <di:waypoint x="316" y="170" />
        <di:waypoint x="380" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-manual-task-to-sub-process-end_di" bpmnElement="flow-manual-task-to-sub-process-end">
        <di:waypoint x="480" y="170" />
        <di:waypoint x="552" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-sub-process-to-end_di" bpmnElement="flow-sub-process-to-end">
        <di:waypoint x="640" y="170" />
        <di:waypoint x="702" y="170" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
