<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0" id="Definitions_manual_task_multi_instance_message_boundary" targetNamespace="http://bpmn.io/schema/bpmn" exporter="ZenBPM Modeler" exporterVersion="1.0.0">
  <bpmn:process id="manual-task-multi-instance-message-boundary-process" name="Manual task multi-instance message boundary" isExecutable="true">
    <bpmn:startEvent id="start">
      <bpmn:outgoing>flow-start-to-manual-task</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow-start-to-manual-task" sourceRef="start" targetRef="manual-task" />
    <bpmn:manualTask id="manual-task" name="Sign each contract">
      <bpmn:extensionElements>
        <zenbpm:ioMapping>
          <!-- Deliberately invalid FEEL: every iteration fails, keeping the parent waiting so its boundary events can interrupt it. -->
          <zenbpm:input source="=iban: &#34;DE456&#34;	" target="signedContract" />
        </zenbpm:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>flow-start-to-manual-task</bpmn:incoming>
      <bpmn:outgoing>flow-manual-task-to-end</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zenbpm:loopCharacteristics inputCollection="=contracts" inputElement="contract" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="flow-manual-task-to-end" sourceRef="manual-task" targetRef="end" />
    <bpmn:endEvent id="end">
      <bpmn:incoming>flow-manual-task-to-end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="boundary-message" attachedToRef="manual-task">
      <bpmn:outgoing>flow-boundary-message-to-end</bpmn:outgoing>
      <bpmn:messageEventDefinition id="boundary-message-definition" messageRef="manual-task-boundary-message-id" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flow-boundary-message-to-end" sourceRef="boundary-message" targetRef="end-after-message" />
    <bpmn:endEvent id="end-after-message">
      <bpmn:incoming>flow-boundary-message-to-end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="boundary-unused-message" attachedToRef="manual-task">
      <bpmn:outgoing>flow-unused-boundary-to-end</bpmn:outgoing>
      <bpmn:messageEventDefinition id="boundary-unused-message-definition" messageRef="manual-task-unused-boundary-message-id" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flow-unused-boundary-to-end" sourceRef="boundary-unused-message" targetRef="end-after-unused-message" />
    <bpmn:endEvent id="end-after-unused-message">
      <bpmn:incoming>flow-unused-boundary-to-end</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:message id="manual-task-boundary-message-id" name="manual-task-boundary-message">
    <bpmn:extensionElements>
      <zenbpm:subscription correlationKey="=&#34;manual-task-boundary&#34;" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="manual-task-unused-boundary-message-id" name="manual-task-unused-boundary-message">
    <bpmn:extensionElements>
      <zenbpm:subscription correlationKey="=&#34;manual-task-boundary&#34;" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="manual-task-multi-instance-message-boundary-process">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="152" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="manual-task_di" bpmnElement="manual-task">
        <dc:Bounds x="240" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="392" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="boundary-message_di" bpmnElement="boundary-message">
        <dc:Bounds x="244" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end-after-message_di" bpmnElement="end-after-message">
        <dc:Bounds x="392" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-start-to-manual-task_di" bpmnElement="flow-start-to-manual-task">
        <di:waypoint x="188" y="100" />
        <di:waypoint x="240" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-manual-task-to-end_di" bpmnElement="flow-manual-task-to-end">
        <di:waypoint x="340" y="100" />
        <di:waypoint x="392" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-boundary-message-to-end_di" bpmnElement="flow-boundary-message-to-end">
        <di:waypoint x="262" y="158" />
        <di:waypoint x="262" y="210" />
        <di:waypoint x="392" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="boundary-unused-message_di" bpmnElement="boundary-unused-message">
        <dc:Bounds x="298" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end-after-unused-message_di" bpmnElement="end-after-unused-message">
        <dc:Bounds x="512" y="262" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-unused-boundary-to-end_di" bpmnElement="flow-unused-boundary-to-end">
        <di:waypoint x="316" y="158" />
        <di:waypoint x="316" y="170" />
        <di:waypoint x="530" y="170" />
        <di:waypoint x="530" y="262" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
