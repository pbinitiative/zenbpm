{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "aew9mifcmw0e8d" },
      "description": "Time since the newest completed raft snapshot of each partition was written. An old snapshot can be normal on an idle partition; investigate it together with write activity and raft state. rqlite_snapshot_age_seconds is exported per replica and deduplicated with max by(partition); -1 is reported until the first completed snapshot exists.",
      "fieldConfig": {
        "defaults": {
          "mappings": [ { "type": "value", "options": { "-1": { "text": "no completed snapshot yet", "color": "yellow", "index": 0 } } } ],
          "unit": "dtdurations",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "id": 7,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "expr": "max by(partition) (rqlite_snapshot_age_seconds)", "instant": true, "legendFormat": "partition {{partition}}", "refId": "A" }
      ],
      "title": "Time since last snapshot",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "aew9mifcmw0e8d" },
      "description": "Physical on-disk size of the partition raft log (bbolt), useful for capacity monitoring. Logical raft truncation frees pages for reuse inside bbolt but does not normally shrink this file, so file-size changes do not directly indicate snapshot or compaction success. Exported per replica, deduplicated with max by(partition).",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "unit": "bytes",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 2000000000 } ] }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "id": 8,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "expr": "max by(partition) (rqlite_raft_log_size_bytes)", "instant": true, "legendFormat": "partition {{partition}}", "refId": "A" }
      ],
      "title": "Raft log size on disk",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "aew9mifcmw0e8d" },
      "description": "Time since this process observed a new completed raft snapshot on the partition. The first scan after startup establishes a baseline and is not counted as a new observation; -1 means no new snapshot has been observed since startup.",
      "fieldConfig": {
        "defaults": {
          "mappings": [ { "type": "value", "options": { "-1": { "text": "not observed since startup", "color": "yellow", "index": 0 } } } ],
          "unit": "dtdurations",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "id": 9,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "expr": "max by(partition) (rqlite_snapshot_observation_age_seconds)", "instant": true, "legendFormat": "partition {{partition}}", "refId": "A" }
      ],
      "title": "Time since new snapshot observed",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "aew9mifcmw0e8d" },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10 }, "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "rqlite_db_size_bytes", "legendFormat": "partition {{partition}} {{instance}}", "refId": "A" }
      ],
      "title": "rqlite DB size",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "aew9mifcmw0e8d" },
      "description": "Physical bbolt raft-log file size over time for capacity monitoring. bbolt normally reuses pages freed by logical raft truncation instead of shrinking the file, so this series does not directly show compaction events.",
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10 }, "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 10,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "rqlite_raft_log_size_bytes", "legendFormat": "partition {{partition}} {{instance}}", "refId": "A" }
      ],
      "title": "Raft log size",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "aew9mifcmw0e8d" },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10 }, "unit": "binBps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "deriv(rqlite_db_size_bytes[30m])", "legendFormat": "partition {{partition}} growth", "refId": "A" }
      ],
      "title": "rqlite DB growth rate (30m)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "aew9mifcmw0e8d" },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10 }, "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by(le, partition) (rate(rqlite_exec_duration_milliseconds_bucket[$__rate_interval])))", "legendFormat": "p50 partition {{partition}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by(le, partition) (rate(rqlite_exec_duration_milliseconds_bucket[$__rate_interval])))", "legendFormat": "p95 partition {{partition}}", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by(le, partition) (rate(rqlite_exec_duration_milliseconds_bucket[$__rate_interval])))", "legendFormat": "p99 partition {{partition}}", "refId": "C" }
      ],
      "title": "rqlite write latency percentiles",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "aew9mifcmw0e8d" },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10 }, "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by(le, partition) (rate(rqlite_query_duration_milliseconds_bucket[$__rate_interval])))", "legendFormat": "p50 partition {{partition}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by(le, partition) (rate(rqlite_query_duration_milliseconds_bucket[$__rate_interval])))", "legendFormat": "p95 partition {{partition}}", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by(le, partition) (rate(rqlite_query_duration_milliseconds_bucket[$__rate_interval])))", "legendFormat": "p99 partition {{partition}}", "refId": "C" }
      ],
      "title": "rqlite read latency percentiles",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "aew9mifcmw0e8d" },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "sum by(partition) (rate(rqlite_exec_duration_milliseconds_count[$__rate_interval]))", "legendFormat": "writes/s partition {{partition}}", "refId": "A" },
        { "expr": "sum by(partition) (rate(rqlite_query_duration_milliseconds_count[$__rate_interval]))", "legendFormat": "reads/s partition {{partition}}", "refId": "B" }
      ],
      "title": "rqlite operation throughput",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "aew9mifcmw0e8d" },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10 }, "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"}", "legendFormat": "{{instance}} {{mountpoint}} free", "refId": "A" }
      ],
      "title": "Disk free (node_exporter)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["zenbpm", "storage"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "ZenBPM Storage / rqlite",
  "uid": "zenbpm-storage",
  "version": 1
}
