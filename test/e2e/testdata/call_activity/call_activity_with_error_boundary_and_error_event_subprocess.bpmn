<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0" id="Definitions_call_activity_with_error_boundary_and_error_event_subprocess" targetNamespace="http://bpmn.io/schema/bpmn" exporter="ZenBPM Modeler" exporterVersion="1.0.0">
  <bpmn:process id="call-activity-with-error-boundary-and-error-event-subprocess" name="Call Activity With Error Boundary And Error Event Subprocess" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_start_call</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_start_call" sourceRef="StartEvent_1" targetRef="call_activity" />
    <bpmn:callActivity id="call_activity" name="Call activity">
      <bpmn:extensionElements>
        <zenbpm:calledElement processId="simple_task_for_call_activity_error_boundary_event" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_call</bpmn:incoming>
      <bpmn:outgoing>Flow_call_completed</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_call_completed" sourceRef="call_activity" targetRef="completed-end" />
    <bpmn:endEvent id="completed-end" name="Completed end">
      <bpmn:incoming>Flow_call_completed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="error_boundary" attachedToRef="call_activity">
      <bpmn:outgoing>Flow_error_handled</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_boundary" errorRef="Error_call_activity" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_error_handled" sourceRef="error_boundary" targetRef="handled-end" />
    <bpmn:endEvent id="handled-end" name="Handled end">
      <bpmn:incoming>Flow_error_handled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="error-event-subprocess" triggeredByEvent="true">
      <bpmn:startEvent id="error-start-event">
        <bpmn:outgoing>Flow_error_sub</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_event_subprocess" errorRef="Error_call_activity" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_error_sub" sourceRef="error-start-event" targetRef="event-subprocess-end" />
      <bpmn:endEvent id="event-subprocess-end" name="Event sub process end">
        <bpmn:incoming>Flow_error_sub</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
  </bpmn:process>
  <bpmn:error id="Error_call_activity" name="Call activity error" errorCode="42" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="call-activity-with-error-boundary-and-error-event-subprocess">
