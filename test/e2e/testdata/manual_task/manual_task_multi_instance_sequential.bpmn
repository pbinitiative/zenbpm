<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0" id="Definitions_manual_task_multi_instance_sequential" targetNamespace="http://bpmn.io/schema/bpmn" exporter="ZenBPM Modeler" exporterVersion="1.0.0">
  <bpmn:process id="manual-task-multi-instance-sequential-e2e" name="Manual task multi-instance sequential" isExecutable="true">
    <bpmn:startEvent id="start">
      <bpmn:outgoing>flow-start-to-manual-task</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow-start-to-manual-task" sourceRef="start" targetRef="manual-task" />
    <bpmn:manualTask id="manual-task" name="Sign each contract">
      <bpmn:extensionElements>
        <zenbpm:ioMapping>
          <zenbpm:input source="=contract + &#34;-signed&#34;" target="signedContract" />
        </zenbpm:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>flow-start-to-manual-task</bpmn:incoming>
      <bpmn:outgoing>flow-manual-task-to-end</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:extensionElements>
          <zenbpm:loopCharacteristics inputCollection="=contracts" inputElement="contract" outputCollection="signedContracts" outputElement="=signedContract" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="flow-manual-task-to-end" sourceRef="manual-task" targetRef="end" />
    <bpmn:endEvent id="end">
      <bpmn:incoming>flow-manual-task-to-end</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="manual-task-multi-instance-sequential-e2e">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="152" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="manual-task_di" bpmnElement="manual-task">
        <dc:Bounds x="240" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="392" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-start-to-manual-task_di" bpmnElement="flow-start-to-manual-task">
        <di:waypoint x="188" y="100" />
        <di:waypoint x="240" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-manual-task-to-end_di" bpmnElement="flow-manual-task-to-end">
        <di:waypoint x="340" y="100" />
        <di:waypoint x="392" y="100" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
